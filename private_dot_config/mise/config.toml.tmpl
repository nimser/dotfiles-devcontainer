# vim: set filetype=toml:
[tools]
# base, EVERYWHERE
chezmoi = "latest"
neovim = "latest"
delta = "latest"
lazygit = "latest"
bat = "latest"
"github:bartei/git-agecrypt" = "latest"
"aqua:tealdeer-rs/tealdeer" = "latest"
"aqua:sharkdp/fd" = "latest"
"github:BurntSushi/ripgrep" = "latest"
"aqua:cli/cli" = "latest" #github-cli
"gitlab:gitlab-org/cli" = "latest" #gitlab-cli
"aqua:tree-sitter/tree-sitter" = "latest"
"aqua:dprint/dprint" = "latest"
"aqua:mvdan/sh" = "latest" # shfmt
direnv = "latest"
{{- if (or (stat "/.dockerenv") (stat "/run/.containerenv"))}}
# Containers only: hosts log in through the distro's own fish, and a second
# copy would win the PATH race against the shell systemd re-execs.
"github:fish-shell/fish-shell" = "latest"
{{- end}}
node = "latest"
uv = "latest"
viteplus = "latest"
pnpm = "latest"
# github backend, not the aqua default: aqua-registry lags upstream releases for
# pi (stale/missing checksums right after a release), which broke `mise upgrade`
# more than once. github: installs straight from the GH release + verifies
# artifact attestation/SLSA provenance, so `latest` is safe to track again.
"github:earendil-works/pi" = "latest"
claude = "latest"
fzf = "latest"
age = "latest"
gopass = "latest"
sops = "latest"
#gcloud = "latest"
yq = "latest"
jq = "latest"
"aqua:nushell/nushell" = "latest"
{{- if (and (has .chezmoi.hostname (list "tpad" "px13")) (not (stat "/.dockerenv")) (not (stat "/run/.containerenv")))}} 
# only for the workstations themselves, excluding containers running on them
"github:yt-dlp/yt-dlp" = "latest"
"pipx:realiti4/claude-swap" = "latest"
"github:olastor/age-plugin-fido2-hmac" = "latest"
"github:Foxboron/age-plugin-tpm" = "latest"
# Pinned: the identity files in ~/.local/state/age were written by this plugin
# version, and an untested upgrade would be discovered at decryption time.
"github:str4d/age-plugin-yubikey" = "0.5.0"
"github:cjpais/Handy" = { version = "latest", matching = "AppImage" }
"aqua:typst/typst" = "latest"
{{- end }}
{{- if (eq (env "DEVPOD_WORKSPACE_ID") "metagrowth")}}
# only for the metagrowth devpod: the mirror publisher filters history with it
"pipx:git-filter-repo" = "latest"
{{- end}}
{{- if (eq (env "DEVPOD_WORKSPACE_ID") "homelab")}}
# only for the homelab devpod
kubectl = "latest"
kubectx = "latest"
kubens = "latest"
helm = "latest"
"aqua:k9s" = "latest"
"aqua:fluxcd/flux2" = "latest"
"aqua:siderolabs/talos" = "latest" # talosctl
{{- end}}
[settings]
idiomatic_version_file_enable_tools = ["node"]
minimum_release_age = "1h" # don't install something younger that this age
use_versions_host = false # disable using `mise-versions` (https://mise-versions.jdx.dev/) use github api directly instead
fetch_remote_versions_cache = "1h" # default
cache_prune_age = "7d" # default is 30d too long
[settings.github]
# The first bootstrap supplies MISE_GITHUB_TOKEN from outside the encrypted
# dotfiles. Once gopass and the bg store are available, later mise runs can
# retrieve the same token without storing it in this config.
# stderr stays open on purpose: a suppressed passphrase prompt reads as a hang.
# stdin is closed and the call is capped so a prompt fails instead of waiting.
credential_command = 'GOPASS_HOMEDIR="$HOME/.config/gopass/.gopass-scripts/" timeout 30 gopass show -o bg/github.com/pat-classic_public-repos < /dev/null || true'
