#!/bin/bash

set -uo pipefail

errors=()
# Containers defer decryption until an interactive login can reach the keys.
with_secrets=true
if [ -f /.dockerenv ] || [ -f /run/.containerenv ]; then
  with_secrets=false
fi
case "${1:-}" in
  "") ;;
  --with-secrets) with_secrets=true ;;
  --without-secrets) with_secrets=false ;;
  --help|-h)
    echo "Usage: bash setup [--without-secrets | --with-secrets]"
    echo "Default: complete host setup; containers defer secrets to first login."
    exit 0 ;;
  *) echo "Unknown argument: $1" >&2; exit 2 ;;
esac
[ "$#" -le 1 ] || { echo "Too many arguments" >&2; exit 2; }

fail() {
  echo "Setup stopped: $*" >&2
  echo "Fix the reported stage, then rerun the same setup command." >&2
  exit 1
}

run_logged() {
  local stage=$1 log
  shift
  log=$(mktemp "${TMPDIR:-/tmp}/setup-${stage}.XXXXXX.log") || return 1
  if "$@" 2>&1 | tee "$log"; then
    rm -f "$log"
  else
    echo "Failed stage: $stage. Full log: $log" >&2
    return 1
  fi
}

# Run nix-env but keep the console output compact.
# - Raw nix fetch/build logs are swallowed (kept in a logfile for diagnostics).
# - On a TTY: a single status line is refreshed with the current package.
# - Otherwise (e.g. `devpod up` logs): one concise line per package.
# - Always ends with a ✅/❌ summary.
install_nix_packages() {
  local log sep sb="" rc fetched built
  log=$(mktemp "${TMPDIR:-/tmp}/nix-install.XXXXXX.log")
  if [ -t 1 ]; then sep='\r\033[K'; else sep='\n'; fi
  command -v stdbuf > /dev/null 2>&1 && sb="stdbuf -oL -eL"

  # tarball-ttl: trust the cached nixpkgs channel tarball for a week instead of
  # the 1h default, so a persistent ~/.cache spares the ~50s fetchTarball+eval
  NIX_CONFIG="${NIX_CONFIG:+$NIX_CONFIG$'\n'}tarball-ttl = 604800" \
  $sb nix-env -f "$HOME/.config/nixpkgs/install.nix" -iA myPackages 2>&1 \
    | tee "$log" \
    | while IFS= read -r line; do
        case "$line" in
          *"copying path '/nix/store/"*)
            n=${line#*store/}; n=${n%%\'*}; n=${n#*-}
            printf "${sep}  \xe2\xac\x87  %-48.48s" "$n"
            ;;
          *"building '/nix/store/"*)
            n=${line#*store/}; n=${n%%.drv*}; n=${n#*-}
            printf "${sep}  \xf0\x9f\x94\xa8 %-48.48s" "$n"
            ;;
        esac
      done
  rc=${PIPESTATUS[0]}

  fetched=$(grep -c "copying path '/nix/store/" "$log" 2> /dev/null || true)
  built=$(grep -c "building '/nix/store/" "$log" 2> /dev/null || true)

  if [ "$rc" -eq 0 ]; then
    printf "${sep}  \xe2\x9c\x85 Nix packages installed (%s fetched, %s built)\n" "$fetched" "$built"
    rm -f "$log"
  else
    printf "${sep}  \xe2\x9d\x8c Nix install failed (%s fetched, %s built before error)\n" "$fetched" "$built"
    grep -iE "error:|failed" "$log" | sed 's/^/       /' | tail -15
    echo "       Full log kept at: $log"
    errors+=("nix-env install failed — see $log or run 'nix-env -f ~/.config/nixpkgs/install.nix -iA myPackages' manually")
  fi
  return "$rc"
}

# Named-volume mountpoints may be root:root (volume predates the image's
# ownership seeding, or onCreateCommand didn't run). Chown them back before
# chezmoi/nix/mise try to write.
for d in "$HOME/.cache" "$HOME/.local" "$HOME/.local/share/mise"; do
  mkdir -p "$d" 2>/dev/null
  if [ ! -w "$d" ]; then
    # ~/.local contains the bind-mounted workspace: don't chown host files
    rflag="-R"; [ "$d" = "$HOME/.local" ] && rflag=""
    if sudo -n chown $rflag "$(id -u):$(id -g)" "$d" 2>/dev/null; then
      echo "🔧 fixed ownership of $d"
    else
      errors+=("$d is not writable and could not be chowned — run 'sudo chown -R $(id -un) $d'")
    fi
  fi
done

# ~/.pi and ~/.claude are bind mounts; Docker creates a missing host-side
# source dir root-owned. Heal only when actually mounted — never mkdir.
for d in "$HOME/.pi" "$HOME/.claude"; do
  if [ -d "$d" ] && [ ! -w "$d" ]; then
    if sudo -n chown -R "$(id -u):$(id -g)" "$d" 2>/dev/null; then
      echo "🔧 fixed ownership of $d"
    else
      errors+=("$d is not writable and could not be chowned — run 'sudo chown -R $(id -un) $d'")
    fi
  fi
done

LOCAL_BIN="$HOME/.local/bin"
GPGID=0x03BC4AD253B82986
mkdir -p "$LOCAL_BIN" || fail "Cannot create $LOCAL_BIN"

# Hooks run in non-interactive shells; do not depend on shell activation.
export PATH="$LOCAL_BIN:$HOME/.local/share/mise/shims:$HOME/.nix-profile/bin:$PATH"

# Setup gpg. Import the public key from the repo copy when available: a fresh
# keyring's `gpg --receive-keys` was measured at 2+ minutes (dirmngr keyserver
# connect timeouts) while a local import is instant and offline.
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd)
PUBKEY_FILE="${SCRIPT_DIR:-.}/.devcontainer/gpg-pubkey.asc"
if gpg --list-keys "$GPGID" > /dev/null 2>&1; then
  : # already in the keyring
elif [ -f "$PUBKEY_FILE" ]; then
  if ! gpg --import "$PUBKEY_FILE" 2>&1; then
    errors+=("GPG key import from $PUBKEY_FILE failed — run 'gpg --receive-keys $GPGID' manually")
  fi
else
  # Fallback: keyserver fetch, but capped so it can't stall setup for minutes
  if ! timeout 60 gpg --keyserver hkps://keyserver.ubuntu.com:443 --receive-keys "$GPGID" 2>&1; then
    errors+=("GPG key retrieval failed — run 'gpg --receive-keys $GPGID' manually")
  fi
fi

# Prerequisite failures must not be reported as a completed installation.
if [ "${#errors[@]}" -gt 0 ]; then
  printf '%s\n' "${errors[@]}" >&2
  fail "Prerequisites are incomplete"
fi

# mise is the package manager for the user-level toolchain, so bootstrap its
# single CLI before chezmoi renders the mise configuration. The installer is
# self-checking and writes only to the user's local bin directory.
if ! command -v mise >/dev/null 2>&1; then
  installer=$(mktemp "${TMPDIR:-/tmp}/install-mise.XXXXXX") || fail "Cannot create mise installer file"
  curl -fsSL https://mise.run -o "$installer" || fail "Cannot download mise installer ($installer)"
  run_logged mise-install env MISE_INSTALL_PATH="$LOCAL_BIN/mise" sh "$installer" \
    || fail "mise installation failed"
  rm -f "$installer"
fi
command -v mise >/dev/null 2>&1 || fail "mise is unavailable after installation"

# mise owns the installed chezmoi. A clean machine still needs one before the
# mise configuration exists, so fetch that copy into a directory that is removed
# when setup exits instead of leaving a second binary shadowed in PATH.
if ! command -v chezmoi >/dev/null; then
  bootstrap_bin=$(mktemp -d "${TMPDIR:-/tmp}/chezmoi-bootstrap.XXXXXX") || fail "Cannot create bootstrap directory"
  trap 'rm -rf "$bootstrap_bin"' EXIT
  installer=$(mktemp "${TMPDIR:-/tmp}/install-chezmoi.XXXXXX") || fail "Cannot create installer file"
  curl -fsLS https://get.chezmoi.io -o "$installer" || fail "Cannot download chezmoi installer ($installer)"
  run_logged chezmoi-install sh "$installer" -b "$bootstrap_bin" || fail "chezmoi installation failed"
  rm -f "$installer"
  export PATH="$bootstrap_bin:$PATH"
fi
CHEZMOI_BIN=$(command -v chezmoi) || fail "chezmoi is not available"

# Deploy configuration and the mise external first. Built-in exclusions keep
# bootstrap free of restore/activation hooks until their prerequisites exist.
run_logged public-apply "$CHEZMOI_BIN" --source "$SCRIPT_DIR" apply --exclude=encrypted,scripts \
  || fail "Public dotfiles failed"

# What a target needs follows what its deployed mise configuration asks for,
# never a second hand-maintained list.
mise_declares() {
  local config="$HOME/.config/mise/config.toml"
  [ -f "$config" ] && grep -q "$1" "$config"
}

# Tools installed by mise link against distro libraries and drive distro
# services. Report what is missing and stop: an unattended run must never answer
# a package-manager prompt, and the requirement follows the deployed mise
# configuration instead of a second hand-maintained package list.
check_native_dependencies() {
  local field install packages hint
  local -a missing=() hints=()

  # No pipe into grep: pipefail turns the reader's early exit into SIGPIPE on
  # ldconfig and every library would look missing.
  have_lib() {
    local cache
    cache=$(ldconfig -p 2>/dev/null) || return 1
    case "$cache" in *"$1"*) return 0 ;; *) return 1 ;; esac
  }

  if mise_declares 'age-plugin-fido2-hmac'; then
    have_lib libfido2.so.1 || missing+=('libfido2|libfido2-1')
  fi
  if mise_declares 'age-plugin-yubikey'; then
    have_lib libpcsclite.so.1 || missing+=('pcsclite|libpcsclite1')
    # ykman selects which gopass store the plugged key unlocks.
    command -v ykman > /dev/null 2>&1 || missing+=('yubikey-manager|yubikey-manager')
    if command -v systemctl > /dev/null 2>&1 \
      && ! systemctl is-enabled pcscd.socket > /dev/null 2>&1; then
      hints+=('sudo systemctl enable --now pcscd.socket')
    fi
  fi
  # Handy is an AppImage, which mounts itself through FUSE 2.
  if mise_declares 'cjpais/Handy'; then
    have_lib libfuse.so.2 || missing+=('fuse2|libfuse2t64')
  fi
  # keyd is required only where this checkout carries its configuration.
  if [ -d "$SCRIPT_DIR/_system/$HOSTNAME/etc/keyd" ]; then
    command -v keyd > /dev/null 2>&1 || missing+=('keyd|keyd')
  fi

  [ "${#missing[@]}" -gt 0 ] || [ "${#hints[@]}" -gt 0 ] || return 0

  # shellcheck disable=SC1091
  . /etc/os-release 2>/dev/null || true
  case " ${ID:-} ${ID_LIKE:-} " in
    *" arch "*) field=1; install='sudo pacman -S --needed' ;;
    *" debian "*|*" ubuntu "*) field=2; install='sudo apt install' ;;
    *) field=1; install='(unrecognised distribution) install' ;;
  esac

  if [ "${#missing[@]}" -gt 0 ]; then
    packages=$(printf '%s\n' "${missing[@]}" | cut -d'|' -f"$field" | tr '\n' ' ')
    echo "Missing native packages required by the configured tools:" >&2
    echo "  $install ${packages% }" >&2
  fi
  for hint in "${hints[@]:-}"; do
    [ -n "$hint" ] && echo "  $hint" >&2
  done
  echo "Run the command above, then rerun the same setup command." >&2
  [ "${#missing[@]}" -eq 0 ]
}
check_native_dependencies || fail "Native dependencies are missing"

# Mise still needs GitHub authentication for its configured release tools, and a
# clean machine has no restored bg store until private apply, so an encrypted
# token cannot be the first credential. Accept it from the caller (or an already
# working installation) and keep it process-local. After private apply, mise's
# credential_command reads the same entry from gopass for later runs.
prepare_mise_github_token() {
  local variable candidate gopass_cmd

  if [ -n "${MISE_GITHUB_TOKEN:-}" ]; then
    return 0
  fi
  for variable in GITHUB_API_TOKEN GITHUB_TOKEN AQUA_GITHUB_TOKEN GH_TOKEN; do
    if [ -n "${!variable:-}" ]; then
      export MISE_GITHUB_TOKEN="${!variable}"
      return 0
    fi
  done

  # This covers reruns after gopass was already installed and its stores were
  # restored. It deliberately does not make the first bootstrap depend on it.
  # stdin is closed and the call is capped: a passphrase prompt must surface as
  # a visible failure, never as a silent wait.
  gopass_cmd=$(command -v gopass 2>/dev/null || true)
  if [ -n "$gopass_cmd" ]; then
    candidate=$(GOPASS_HOMEDIR="$HOME/.config/gopass/.gopass-scripts/" \
      timeout 30 "$gopass_cmd" show -o bg/github.com/pat-classic_public-repos \
      < /dev/null || true)
    if [ -n "$candidate" ]; then
      export MISE_GITHUB_TOKEN="$candidate"
      return 0
    fi
  fi

  # An existing gh login is another safe source on reruns; gh itself is not a
  # prerequisite for the first run and therefore is only consulted here.
  if command -v gh >/dev/null 2>&1; then
    candidate=$(gh auth token 2>/dev/null || true)
    if [ -n "$candidate" ]; then
      export MISE_GITHUB_TOKEN="$candidate"
      return 0
    fi
  fi

  cat >&2 <<'EOF'
No GitHub token is available for mise.
The first clean bootstrap must receive one from the caller because the
encrypted gopass entry is not readable until private apply restores its store
and identities.
Set it only in this shell, then rerun setup:

  read -rsp 'GitHub token: ' MISE_GITHUB_TOKEN; export MISE_GITHUB_TOKEN; echo
  bash setup

The token is not written to the dotfiles or setup state. Once private apply
finishes, later mise runs can retrieve it from the restored bg gopass store.
EOF
  return 1
}

# Package installation is an explicit setup operation, not a side effect of
# every chezmoi apply. Keep package choices in mise/config.toml and Nix config.
install_mise_packages() (
  set -euo pipefail
  cd "$HOME" || exit 1
  mise_cmd=$(command -v mise) || { echo "mise was not deployed by chezmoi" >&2; exit 1; }
  # This function is invoked in a conditional by run_logged, which suppresses
  # Bash errexit inside functions. Propagate failures explicitly.
  "$mise_cmd" trust "$HOME/.config/mise/config.toml" || exit 1
  "$mise_cmd" install || exit 1
  if command -v tldr >/dev/null; then
    tldr --update || exit 1
  fi
  if command -v bat >/dev/null; then
    bat cache --build || exit 1
  fi
)

load_nix() {
  local f d
  for f in /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh /etc/profile.d/nix.sh "$HOME/.nix-profile/etc/profile.d/nix.sh"; do
    if [ -f "$f" ]; then
      # Upstream shell profiles need not be nounset-safe.
      set +u
      source "$f"
      set -u
      break
    fi
  done
  for d in /nix/var/nix/profiles/default/bin "$HOME/.nix-profile/bin"; do
    if [ -x "$d/nix-env" ]; then
      export PATH="$PATH:$d"
      break
    fi
  done
}
load_nix
if ! command -v nix-env >/dev/null; then
  if [ -d /nix ]; then
    fail "Nix files exist in /nix but nix-env is unavailable; inspect the existing installation before reinstalling"
  fi
  installer=$(mktemp "${TMPDIR:-/tmp}/install-nix.XXXXXX") || fail "Cannot create installer file"
  curl -fsSL https://nixos.org/nix/install -o "$installer" || fail "Cannot download Nix installer ($installer)"
  run_logged nix-install sh "$installer" --daemon --yes || fail "Nix installation failed"
  rm -f "$installer"
  load_nix
fi
command -v nix-env >/dev/null || fail "nix-env is unavailable after installation"
for f in config.nix install.nix; do
  [ -f "$HOME/.config/nixpkgs/$f" ] || fail "Missing deployed Nix configuration: $f"
done
# The deployed config.nix already resolved role and container detection, so the
# selection needs no environment variable and no remembered state.
install_nix_packages || fail "Nix package installation failed"

# On a rerun where the bg store and decrypted identities already exist, the
# token can be recovered without caller input. A clean machine still needs the
# one-time external token: the first private apply is what restores that store.
prepare_mise_github_token || fail "mise needs an external GitHub token for the first bootstrap"
run_logged mise-packages install_mise_packages || fail "mise tools or caches failed"

if "$with_secrets"; then
  # Public phase has deployed the age identity references and installed the
  # plugins. Decryption still requires the matching hardware/key material.
  for tool in age gopass; do
    command -v "$tool" >/dev/null 2>&1 \
      || fail "Missing $tool after mise install; rerun mise install before decrypting secrets"
  done
  for tool in age-plugin-tpm age-plugin-yubikey age-plugin-fido2-hmac; do
    mise_declares "$tool" || continue
    command -v "$tool" >/dev/null 2>&1 \
      || fail "Missing $tool after mise install; rerun mise install before decrypting secrets"
  done
  run_logged private-apply "$CHEZMOI_BIN" --source "$SCRIPT_DIR" apply \
    || fail "Private configuration, store restoration, or host activation failed"
  touch "$HOME/.local/state/chezmoi/secrets-applied" || fail "Cannot record completed secret deployment"
  echo "Setup completed, including secrets and store restoration."
elif [ -f /.dockerenv ] || [ -f /run/.containerenv ]; then
  run_logged container-finalize "$CHEZMOI_BIN" --source "$SCRIPT_DIR" apply --exclude=encrypted \
    || fail "Container finalization failed"
  echo "Container bootstrap completed: tools and the bg store are available."
  echo "Pending: first-login decryption of encrypted dotfiles via ~/.profile."
  echo "If login decryption fails, retry interactively: chezmoi apply --include=encrypted"
else
  echo "Bootstrap completed without secrets: dotfiles and tools are installed."
  echo "Pending: encrypted files, password-store restoration, and host activation."
  echo "Connect the matching age hardware key, then run: bash setup"
fi
